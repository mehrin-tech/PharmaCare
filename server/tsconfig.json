{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "allowJs": true,
    "checkJs": false,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "strict": false,

    "outDir": "./dist",
    "rootDir": ".",

    "skipLibCheck": true
  },
  "include": [
    "controllers/**/*.ts",
    "routes/**/*.ts"
, "routes/profileRoutes.js", "controllers/profileController.js"  ]
}